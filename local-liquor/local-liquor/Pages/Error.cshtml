@page
@model ErrorModel

<section class="section" style="padding-top: calc(5.5rem + var(--section-y)); min-height: 70svh">
    <div class="shell shell--content">
        <p class="data">@Model.StatusLabel</p>
        <h1 class="display" style="margin-top: 1.25rem; font-size: clamp(2.25rem, 6vw, 4.5rem)">@L["error.title"]</h1>
        <p class="lede" style="margin-top: 1.75rem">@L["error.body"]</p>

        <p style="margin-top: 2.5rem">
            <a class="btn btn--solid" asp-page="/Index">
                @L["error.home"]
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="data data--light" style="margin-top: 3rem">Request ID: @Model.RequestId</p>
        }
    </div>
</section>
