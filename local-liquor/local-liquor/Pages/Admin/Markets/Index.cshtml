@page "/admin/markeder"
@model MarketsIndexModel
@{
    ViewData["Title"] = "Markeder";
}

<div class="admin-shell">
    <header class="admin-head admin-head--split">
        <div>
            <h1 class="admin-title">Markeder</h1>
            <p class="admin-sub">Vises på forsiden. Datoer der er passeret falder selv af listen.</p>
        </div>
        <a class="btn btn--solid" asp-page="/Admin/Markets/Edit">Nyt marked</a>
    </header>

    @if (TempData["Flash"] is string flash)
    {
        <p class="flash">@flash</p>
    }

    @if (Model.Upcoming.Count == 0 && Model.Past.Count == 0)
    {
        <p class="empty">Der er ikke oprettet nogen markeder endnu.</p>
    }

    @if (Model.Upcoming.Count > 0)
    {
        <section class="panel">
            <h2 class="panel__title">Kommende</h2>
            <partial name="_MarketRows" model="Model.Upcoming" />
        </section>
    }

    @if (Model.Past.Count > 0)
    {
        <section class="panel">
            <h2 class="panel__title">Overstået</h2>
            <p class="panel__hint">Vises ikke på siden, men gemmes her.</p>
            <partial name="_MarketRows" model="Model.Past" />
        </section>
    }
</div>
