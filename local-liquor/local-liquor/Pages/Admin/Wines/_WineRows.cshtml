@model List<Wine>

<ul class="row-list">
    @foreach (var wine in Model)
    {
        <li class="row @(wine.IsPublished ? null : "row--muted")">
            <span class="row__swatch" style="--swatch: @wine.LiquidColor" aria-hidden="true"></span>
            <span class="row__main">
                <a class="row__name" asp-page="/Admin/Wines/Edit" asp-route-id="@wine.Id">@wine.NameDa</a>
                <span class="row__meta">
                    /@wine.Slug · @wine.AlcoholByVolume.ToString("0.#") % · @wine.BatchSize flasker
                </span>
            </span>
            <span class="row__tags">
                @if (wine.IsHero)
                {
                    <span class="tag tag--hero">Hovedflaske</span>
                }
                @if (!wine.IsPublished)
                {
                    <span class="tag">Skjult</span>
                }
                @switch (wine.Stock)
                {
                    case StockStatus.SoldOut:
                        <span class="tag tag--out">Udsolgt</span>
                        break;
                    case StockStatus.Low:
                        <span class="tag tag--low">Få tilbage</span>
                        break;
                }
            </span>
        </li>
    }
</ul>
