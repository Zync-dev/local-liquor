@page
@model PrivacyModel

<section class="section" style="padding-top: calc(5.5rem + var(--section-y))">
    <div class="shell shell--content">
        <p class="data">@L["footer.privacy"]</p>
        <h1 class="h-section" style="margin-top: 1.25rem; max-width: 18ch">@L["privacy.lede"]</h1>

        <div class="prose" style="display: grid; gap: 2.5rem; margin-top: 3rem">
            <div>
                <h2 class="h-card" style="margin-bottom: .75rem; color: var(--ink)">@L["privacy.cookies.title"]</h2>
                <p>@L["privacy.cookies.body"]</p>
            </div>
            <div>
                <h2 class="h-card" style="margin-bottom: .75rem; color: var(--ink)">@L["privacy.storage.title"]</h2>
                <p>@L["privacy.storage.body"]</p>
            </div>
            <div>
                <h2 class="h-card" style="margin-bottom: .75rem; color: var(--ink)">@L["privacy.tracking.title"]</h2>
                <p>@L["privacy.tracking.body"]</p>
            </div>
            <div>
                <h2 class="h-card" style="margin-bottom: .75rem; color: var(--ink)">@L["privacy.contact.title"]</h2>
                <p>@L["privacy.contact.body"]</p>
            </div>
        </div>
    </div>
</section>
