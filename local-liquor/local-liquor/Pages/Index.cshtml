@page
@using System.Globalization
@model IndexModel
@{
    var hero = Model.Wines.ElementAtOrDefault(Model.HeroIndex);
}

<partial name="_WineData" model="Model.Wines" />

@* ============================================================ hero ====== *@
<section class="hero" data-hero data-hero-index="@Model.HeroIndex"
         style="--accent: @(hero?.AccentColor ?? "#c0453c")">
    <div class="shell hero__inner">
        @* Inside the grid so it can be reordered between the copy and the picker
           on narrow screens; absolutely positioned over the hero on wide ones. *@
        <div class="hero__stage" data-stage aria-hidden="true">
            <div class="hero__fallback" data-hero-fallback>
                <canvas data-label-canvas="@hero?.Slug" width="677" height="991"
                        role="img" aria-label="@hero?.Name"></canvas>
            </div>
        </div>

        <div class="hero__copy">
            @* Not data-reveal: the head runs its own reveal, a per-line rise out
               of a clipped box, which is the first thing anyone sees. *@
            <div class="hero__head">
                <p class="data hero__eyebrow"><span>@L["hero.eyebrow"]</span></p>
                <h1 class="display hero__title">
                    <span class="line" style="--line: 0"><span>@L["hero.title.1"]</span></span>
                    <span class="line" style="--line: 1"><span>@L["hero.title.2"]</span></span>
                </h1>
            </div>
            <div class="hero__body">
                <p class="lede">@L["hero.lede"]</p>
                <div class="hero__actions">
                    <a class="btn btn--solid" href="#sortiment">
                        @L["hero.cta.range"]
                        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="btn btn--ghost" href="#kontakt">@L["nav.contact"]</a>
                </div>
            </div>
        </div>

        <div class="hero__picker" data-reveal style="--reveal-delay: 150ms">
            <span class="data picker__hint">@L["hero.hint"]</span>
            <ul class="picker__list" data-picker>
                @for (var i = 0; i < Model.Wines.Count; i++)
                {
                    var wine = Model.Wines[i];
                    <li>
                        <button class="picker__btn" type="button"
                                data-picker-btn="@i"
                                data-accent="@wine.AccentColor"
                                style="--wine-accent: @wine.AccentColor"
                                aria-current="@(i == Model.HeroIndex ? "true" : "false")">
                            <span>@wine.Name</span>
                            <span class="picker__dot" aria-hidden="true"></span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@* ============================================================ ticker ==== *@
@* Marquee of the same facts the label carries. Two identical runs so the
   translate can loop at exactly -50% with no seam. *@
<div class="ticker" aria-hidden="true">
    <div class="ticker__track">
        @for (var run = 0; run < 2; run++)
        {
            <div class="ticker__run">
                @foreach (var word in new[] { "Frugtvin", "Danmark", "Est. 2023", "750 ml",
                                              "Presset i hånden", "Uklar og tør", "Små hold" })
                {
                    <span class="ticker__item">@word</span>
                }
                @foreach (var wine in Model.Wines)
                {
                    <span class="ticker__item ticker__item--accent"
                          style="--accent: @wine.AccentColor">@wine.LabelName</span>
                }
            </div>
        }
    </div>
</div>

@* =========================================================== figures ==== *@
<section class="shell">
    <ul class="stats">
        <li class="stat" data-reveal>
            <span class="stat__value">@Model.Wines.Count</span>
            <span class="data stat__label">@L["stat.varieties"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 70ms">
            <span class="stat__value">100 %</span>
            <span class="data stat__label">@L["stat.fruit"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 140ms">
            <span class="stat__value">750</span>
            <span class="data stat__label">@L["stat.volume"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 210ms">
            <span class="stat__value">2023</span>
            <span class="data stat__label">@L["stat.year"]</span>
        </li>
    </ul>
</section>

@* ============================================================ range ===== *@
@* An index rather than a set of cards. The label is the artwork, so every row
   keeps a slot for it and the label rises into that slot on hover — a reserved
   slot, never absolute, so nothing reflows and nothing lands on anything else. *@
<section class="section section--index" id="sortiment">
    <div class="shell index__head">
        <div data-reveal>
            <p class="data">@L["range.eyebrow"]</p>
            <h2 class="h-section" style="margin-top: 1.25rem">@L["range.title"]</h2>
        </div>
        <p class="prose" data-reveal style="--reveal-delay: 90ms">@L["range.lede"]</p>
    </div>

    <ul class="index">
        @for (var i = 0; i < Model.Wines.Count; i++)
        {
            var wine = Model.Wines[i];
            <li class="index__item" data-reveal style="--reveal-delay: @(i * 80)ms">
                <a class="index__row @(wine.IsSoldOut ? "is-sold-out" : null)"
                   style="--accent: @wine.AccentColor"
                   asp-page="/Vin" asp-route-slug="@wine.Slug">
                    <span class="shell index__inner">
                        <span class="data index__no">@((i + 1).ToString("00"))</span>

                        <span class="index__main">
                            <span class="index__name">@wine.Name</span>
                            <span class="data index__sub">@wine.SubtitleEn</span>
                        </span>

                        <span class="index__meta">
                            <span class="data data--ink">
                                @wine.VolumeMl ML &middot; @wine.AlcoholByVolume.ToString("0.#") % VOL.
                            </span>
                            <partial name="_StockBadgeInline" model="wine" />
                        </span>

                        <span class="index__art" aria-hidden="true">
                            <canvas data-label-canvas="@wine.Slug" width="677" height="991"></canvas>
                        </span>

                        <span class="index__go" aria-hidden="true">&rarr;</span>
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

@* ============================================================ photos ==== *@
<partial name="_PhotoStrip" model="Model.Photos" />

@* ========================================================== contact ===== *@
@* Ink on paper, inverted. The same two colours and nothing new — but after a
   whole page of paper it lands, and it gives the page an ending rather than a
   stop. *@
<section class="section contact" id="kontakt">
    <div class="shell contact__grid">
        <div class="contact__intro" data-reveal>
            <p class="data contact__eyebrow">@L["contact.eyebrow"]</p>
            <h2 class="contact__title">@L["contact.title"]</h2>
            <p class="contact__lede">@L["contact.body"]</p>

            <a class="contact__mail" href="mailto:kontakt@@localliquor.dk">kontakt@@localliquor.dk</a>
        </div>

        <div class="contact__form-wrap" data-reveal style="--reveal-delay: 90ms">
            @if (Model.Sent)
            {
                <div class="contact__sent" role="status">
                    <p class="contact__sent-line">@L["contact.sent.title"]</p>
                    <p class="contact__lede">@L["contact.sent.body"]</p>
                </div>
            }
            else
            {
                <form class="cform" method="post" asp-page-handler="Contact" novalidate>
                    <div asp-validation-summary="ModelOnly" class="cform__errors"></div>

                    <label class="cfield">
                        <span class="data cfield__label">@L["contact.form.name"]</span>
                        <input class="cfield__input" asp-for="Form.Name" autocomplete="name" required />
                        <span asp-validation-for="Form.Name" class="cfield__error"></span>
                    </label>

                    <label class="cfield">
                        <span class="data cfield__label">@L["contact.form.email"]</span>
                        <input class="cfield__input" asp-for="Form.Email" type="email"
                               autocomplete="email" inputmode="email" required />
                        <span asp-validation-for="Form.Email" class="cfield__error"></span>
                    </label>

                    <label class="cfield">
                        <span class="data cfield__label">@L["contact.form.message"]</span>
                        <textarea class="cfield__input" asp-for="Form.Message" rows="5" required></textarea>
                        <span asp-validation-for="Form.Message" class="cfield__error"></span>
                    </label>

                    @* Left empty by people and filled in by bots. Hidden from both
                       the screen and the accessibility tree, and never focusable. *@
                    <div class="cform__trap" aria-hidden="true">
                        <label>
                            Website
                            <input asp-for="Form.Website" type="text" tabindex="-1" autocomplete="off" />
                        </label>
                    </div>

                    <button class="btn btn--paper cform__send" type="submit">
                        @L["contact.form.send"]
                        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                    </button>

                    <p class="data cform__note">@L["contact.form.note"]</p>
                </form>
            }
        </div>
    </div>
</section>
