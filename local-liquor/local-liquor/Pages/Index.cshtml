@page
@using System.Globalization
@model IndexModel
@{
    var hero = Model.Wines.ElementAtOrDefault(Model.HeroIndex);
}

<partial name="_WineData" model="Model.Wines" />

@* ============================================================ hero ====== *@
<section class="hero" data-hero data-hero-index="@Model.HeroIndex"
         style="--accent: @(hero?.AccentColor ?? "#c0453c")">
    <div class="shell hero__inner">
        @* Inside the grid so it can be reordered between the copy and the picker
           on narrow screens; absolutely positioned over the hero on wide ones. *@
        <div class="hero__stage" data-stage aria-hidden="true">
            <div class="hero__fallback" data-hero-fallback>
                <canvas data-label-canvas="@hero?.Slug" width="677" height="991"
                        role="img" aria-label="@hero?.Name"></canvas>
            </div>
        </div>

        <div class="hero__copy">
            @* Not data-reveal: the head runs its own reveal, a per-line rise out
               of a clipped box, which is the first thing anyone sees. *@
            <div class="hero__head">
                <p class="data hero__eyebrow"><span>@L["hero.eyebrow"]</span></p>
                <h1 class="display hero__title">
                    <span class="line" style="--line: 0"><span>@L["hero.title.1"]</span></span>
                    <span class="line" style="--line: 1"><span>@L["hero.title.2"]</span></span>
                </h1>
            </div>
            <div class="hero__body">
                <p class="lede">@L["hero.lede"]</p>
                <div class="hero__actions">
                    <a class="btn btn--solid" href="#sortiment">
                        @L["hero.cta.range"]
                        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="btn btn--ghost" href="#kontakt">@L["nav.contact"]</a>
                </div>
            </div>
        </div>

        <div class="hero__picker" data-reveal style="--reveal-delay: 150ms">
            <span class="data picker__hint">@L["hero.hint"]</span>
            <ul class="picker__list" data-picker>
                @for (var i = 0; i < Model.Wines.Count; i++)
                {
                    var wine = Model.Wines[i];
                    <li>
                        <button class="picker__btn" type="button"
                                data-picker-btn="@i"
                                data-accent="@wine.AccentColor"
                                style="--wine-accent: @wine.AccentColor"
                                aria-current="@(i == Model.HeroIndex ? "true" : "false")">
                            <span>@wine.Name</span>
                            <span class="picker__dot" aria-hidden="true"></span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>

    <p class="data hero__scroll" aria-hidden="true">@L["hero.scroll"]</p>
</section>

@* ============================================================ ticker ==== *@
@* Marquee of the same facts the label carries. Two identical runs so the
   translate can loop at exactly -50% with no seam. *@
<div class="ticker" aria-hidden="true">
    <div class="ticker__track">
        @for (var run = 0; run < 2; run++)
        {
            <div class="ticker__run">
                @foreach (var word in new[] { "Frugtvin", "Danmark", "Est. 2023", "750 ml",
                                              "Presset i hånden", "Uklar og tør", "Små hold" })
                {
                    <span class="ticker__item">@word</span>
                }
                @foreach (var wine in Model.Wines)
                {
                    <span class="ticker__item ticker__item--accent"
                          style="--accent: @wine.AccentColor">@wine.LabelName</span>
                }
            </div>
        }
    </div>
</div>

@* =========================================================== figures ==== *@
<section class="shell">
    <ul class="stats">
        <li class="stat" data-reveal>
            <span class="stat__value">@Model.Wines.Count</span>
            <span class="data stat__label">@L["stat.varieties"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 70ms">
            <span class="stat__value">100 %</span>
            <span class="data stat__label">@L["stat.fruit"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 140ms">
            <span class="stat__value">750</span>
            <span class="data stat__label">@L["stat.volume"]</span>
        </li>
        <li class="stat" data-reveal style="--reveal-delay: 210ms">
            <span class="stat__value">2023</span>
            <span class="data stat__label">@L["stat.year"]</span>
        </li>
    </ul>
</section>

@* ============================================================ range ===== *@
<section class="section" id="sortiment">
    <div class="shell">
        <div class="range__head">
            <div data-reveal>
                <p class="data">@L["range.eyebrow"]</p>
                <h2 class="h-section" style="margin-top: 1.25rem">@L["range.title"]</h2>
            </div>
            <p class="prose" data-reveal style="--reveal-delay: 90ms">@L["range.lede"]</p>
        </div>

        <div class="wines">
            @for (var i = 0; i < Model.Wines.Count; i++)
            {
                var wine = Model.Wines[i];
                <a class="wine-card @(wine.IsSoldOut ? "is-sold-out" : null)" data-reveal
                   style="--wine-accent: @wine.AccentColor; --reveal-delay: @(i * 90)ms"
                   asp-page="/Vin" asp-route-slug="@wine.Slug">
                    <span class="wine-card__art">
                        <canvas data-label-canvas="@wine.Slug" width="677" height="991"
                                role="img" aria-label="@wine.Name"></canvas>
                        <partial name="_StockBadge" model="wine" />
                    </span>
                    <span>
                        <span class="wine-card__name">@wine.Name</span>
                        <span class="data wine-card__sub">@wine.SubtitleEn</span>
                        <span class="wine-card__body">@wine.Tagline</span>
                        <span class="wine-card__foot">
                            <span class="data data--ink">
                                @wine.VolumeMl ML · @wine.AlcoholByVolume.ToString("0.#") % VOL.
                            </span>
                            <span class="data data--ink">@L["range.link"] &rarr;</span>
                        </span>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

@* ========================================================== markeder ==== *@
<section class="section" id="markeder">
    <div class="shell shell--content">
        <div class="markets__head" data-reveal>
            <p class="data">@L["markets.eyebrow"]</p>
            <h2 class="h-section" style="margin-top: 1.25rem">@L["markets.title"]</h2>
        </div>

        @if (Model.Markets.Count == 0)
        {
            <p class="prose" data-reveal>@L["markets.none"]</p>
        }
        else
        {
            <ul class="markets">
                @foreach (var market in Model.Markets)
                {
                    <li class="market" data-reveal>
                        <span class="data market__date">@market.DateRange(CultureInfo.CurrentUICulture)</span>
                        <span class="market__body">
                            <span class="market__title">@market.Title</span>
                            <span class="market__place">
                                @market.Place
                                @if (market.Address is not null)
                                {
                                    <text>· @market.Address</text>
                                }
                                @if (market.Hours is not null)
                                {
                                    <text>· @market.Hours</text>
                                }
                            </span>
                        </span>
                        @if (market.Url is not null)
                        {
                            <a class="link market__link" href="@market.Url" rel="noopener noreferrer" target="_blank">
                                @L["markets.more"] <span aria-hidden="true">&rarr;</span>
                            </a>
                        }
                    </li>
                }
            </ul>
        }

        <partial name="_PhotoStrip" model="Model.Photos" />
    </div>
</section>

@* ========================================================== contact ===== *@
<section class="section" id="kontakt">
    <div class="shell shell--content">
        <div class="contact__grid">
            <div data-reveal>
                <p class="data">@L["contact.eyebrow"]</p>
                <h2 class="h-section" style="margin-top: 1.25rem">@L["contact.title"]</h2>
                <p class="prose" style="margin-top: 1.5rem">@L["contact.body"]</p>
            </div>

            <div class="detail-list" data-reveal style="--reveal-delay: 90ms">
                <div>
                    <span class="data detail__label">@L["contact.email.label"]</span>
                    <a class="detail__value" href="mailto:kontakt@@localliquor.dk">kontakt@@localliquor.dk</a>
                </div>
                <div>
                    <span class="data detail__label">@L["contact.visit.label"]</span>
                    <span class="detail__value">Nørholmsvej 69<br />9000 Aalborg</span>
                </div>
                <div>
                    <span class="data detail__label">@L["contact.hours.label"]</span>
                    <span class="detail__value">@L["contact.hours.value"]</span>
                </div>
            </div>
        </div>
    </div>
</section>
