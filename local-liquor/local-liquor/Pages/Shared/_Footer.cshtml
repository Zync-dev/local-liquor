@inject WineService Wines
@{
    var wines = await Wines.GetPublishedAsync();
}

<footer class="site-footer">
    <div class="shell">
        <div class="footer__top">
            <div>
                <div class="wordmark">
                    <partial name="_Wordmark" />
                </div>
                <p class="footer__tagline">@L["footer.tagline"]</p>
            </div>

            <div class="footer__nav">
                <nav aria-label="@L["footer.nav.wines"]">
                    <p class="data footer__nav-title">@L["footer.nav.wines"]</p>
                    @foreach (var wine in wines)
                    {
                        <a asp-page="/Vin" asp-route-slug="@wine.Slug">@wine.Name</a>
                    }
                </nav>
                <nav aria-label="@L["footer.nav.site"]">
                    <p class="data footer__nav-title">@L["footer.nav.site"]</p>
                    <a href="~/#kontakt">@L["nav.contact"]</a>
                    <a asp-page="/Privacy">@L["footer.privacy"]</a>
                </nav>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="data age-note">@L["footer.age"]</p>
            <p class="data">&copy; @DateTime.Now.Year Local Liquor · @L["footer.rights"]</p>
        </div>
    </div>
</footer>
