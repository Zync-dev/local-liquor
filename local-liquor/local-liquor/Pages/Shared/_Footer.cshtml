@inject WineService Wines
@{
    var wines = await Wines.GetPublishedAsync();
}

<footer class="site-footer" id="kontakt-footer">
    <div class="shell">
        <div class="footer__top">
            <div class="footer__brand">
                <img src="~/img/logo.png" alt="Local Liquor" width="1672" height="846" />
                <p class="footer__tagline">@L["footer.tagline"]</p>
            </div>

            <div class="footer__nav">
                <nav aria-label="@L["footer.nav.wines"]">
                    <p class="footer__nav-title">@L["footer.nav.wines"]</p>
                    @foreach (var wine in wines)
                    {
                        <a asp-page="/Vin" asp-route-slug="@wine.Slug">@wine.Name</a>
                    }
                </nav>
                <nav aria-label="@L["footer.nav.site"]">
                    <p class="footer__nav-title">@L["footer.nav.site"]</p>
                    <a href="~/#historien">@L["nav.story"]</a>
                    <a href="~/#haandvaerket">@L["nav.craft"]</a>
                    <a href="~/#kontakt">@L["nav.contact"]</a>
                    <a asp-page="/Privacy">@L["footer.privacy"]</a>
                </nav>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="age-note">@L["footer.age"]</p>
            <p>&copy; @DateTime.Now.Year Local Liquor<span class="dot">.</span> @L["footer.rights"]</p>
        </div>
    </div>
</footer>
