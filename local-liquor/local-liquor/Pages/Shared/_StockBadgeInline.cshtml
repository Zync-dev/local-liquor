@model WineView
@if (Model.Stock != local_liquor.Data.Entities.StockStatus.Available)
{
    <p class="data data--ink stock-line">
        @(Model.IsSoldOut ? L["stock.soldout"] : L["stock.low"])
        @if (!Model.IsSoldOut && Model.BottlesLeft is > 0)
        {
            <span>· @Model.BottlesLeft @L["product.batch.unit"]</span>
        }
    </p>
}
