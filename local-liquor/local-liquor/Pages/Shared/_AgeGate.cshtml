@*
    Age gate. Rendered on every page but closed by default, so the markup below
    it is always present for crawlers and for anyone browsing without
    JavaScript.

    The small inline script opens it during parse rather than waiting for
    site.js, which stops the page flashing behind it. Wiring the buttons is left
    to site.js: if that fails to load the gate simply stays shut, which is the
    safe direction for this particular control.
*@
<dialog class="age-gate" id="age-gate" aria-labelledby="age-gate-title" data-age-gate>
    <div class="age-gate__inner">
        <div class="wordmark">
            <partial name="_Wordmark" />
        </div>

        <div data-age-ask>
            <p class="age-gate__title" id="age-gate-title">@L["age.title"]</p>
            <p class="age-gate__lede">@L["age.lede"]</p>

            <div class="age-gate__actions">
                <button class="btn btn--solid" type="button" data-age-yes>
                    @L["age.yes"]
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </button>
                <button class="btn btn--ghost" type="button" data-age-no>@L["age.no"]</button>
            </div>

            <p class="data data--light age-gate__note">@L["age.remember"]</p>
        </div>

        <div data-age-denied hidden>
            <p class="age-gate__title">@L["age.denied.title"]</p>
            <p class="age-gate__lede">@L["age.denied.body"]</p>
        </div>
    </div>
</dialog>

<script>
    (function () {
        var gate = document.getElementById("age-gate");
        if (!gate || typeof gate.showModal !== "function") return;
        var ok = false;
        try { ok = localStorage.getItem("ll-age") === "ok"; } catch (e) { ok = false; }
        if (!ok) gate.showModal();
    })();
</script>
